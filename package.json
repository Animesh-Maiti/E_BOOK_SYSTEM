{
  "name": "ebook-management-system",
  "version": "0.1.0",
  "description": "E-Book Management System boilerplate (Express + MongoDB + Mongoose)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "seed": "node seed.js",
    "build": "npm install && node seed.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "mongoose": "^7.0.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^2.0.22",
    "supertest": "^7.2.2"
  },
  "jest": {
    "setupFilesAfterEnv": ["<rootDir>/tests/setup.js"]
  }
}
